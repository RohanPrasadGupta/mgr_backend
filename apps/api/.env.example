NODE_ENV=development
PORT=8000
DATABASE_URL=postgres://moneymgr:moneymgr@localhost:5432/moneymgr
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
CORS_ORIGINS=http://localhost:3000,http://localhost:8081

# Shared store for rate limits, sign-in lockouts and one-time email tokens.
# Leave unset to keep them in memory (fine for a single local instance).
REDIS_URL=redis://localhost:6380
# Every key is namespaced under this prefix (rate limits: <prefix>rl:, auth state: <prefix>auth:...).
REDIS_PREFIX=mm:

# Links in emails point here.
APP_URL=http://localhost:3000
# log = print emails (with their links) to the API log; smtp = send through SMTP_URL.
# Local inbox: `docker compose -f infra/docker-compose.yml up -d mailpit`, then open http://localhost:8025
MAIL_TRANSPORT=log
SMTP_URL=smtp://localhost:1025
MAIL_FROM=MoneyMgr <no-reply@moneymgr.local>

# Requests per minute per IP: whole API, then sign-in / sign-up / password endpoints.
RATE_LIMIT_PER_MIN=600
AUTH_RATE_LIMIT_PER_MIN=10
LOGIN_MAX_FAILURES=5

# Receipts/attachments (local disk until S3 is configured).
UPLOAD_DIR=./uploads
