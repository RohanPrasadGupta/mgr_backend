NODE_ENV=development
PORT=8000
DATABASE_URL=postgres://moneymgr:moneymgr@localhost:5432/moneymgr
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
CORS_ORIGINS=http://localhost:3000,http://localhost:8081
# Who may set X-Forwarded-For: true (dev), or in production only the proxy network, e.g. 172.28.0.0/24
# TRUST_PROXY=true

# Admin dashboard (mgr_admin). Signs admin tokens with a key separate from JWT_SECRET; required in production.
# Create the first admin with: pnpm --filter @moneymgr/api admin create --email you@example.com --name "You"
ADMIN_SECRET=change-me-to-a-different-long-random-string-32+
# ADMIN_ACCESS_TTL_SEC=600
# ADMIN_SESSION_HOURS=12
# ADMIN_SUPPORT_MINUTES=30

# Shared store for rate limits, sign-in lockouts and one-time email tokens.
# Leave unset to keep them in memory (fine for a single local instance).
REDIS_URL=redis://localhost:6380
# Every key is namespaced under this prefix (rate limits: <prefix>rl:, auth state: <prefix>auth:...).
REDIS_PREFIX=mm:

# Links in emails point here.
APP_URL=http://localhost:3000
# log = print emails (with their links) to the API log; smtp = send through SMTP_URL;
# brevo = send through Brevo's HTTPS API (for hosts that block SMTP, e.g. Render's free plan): set BREVO_API_KEY,
# and MAIL_FROM must be a sender verified in Brevo (Senders, Domains & Dedicated IPs → Senders).
# Local inbox: `docker compose -f infra/docker-compose.yml up -d mailpit`, then open http://localhost:8025
MAIL_TRANSPORT=log
SMTP_URL=smtp://localhost:1025
MAIL_FROM=MoneyMgr <no-reply@moneymgr.local>
# BREVO_API_KEY=

# Requests per minute per IP: whole API, then sign-in / sign-up / password endpoints.
RATE_LIMIT_PER_MIN=600
AUTH_RATE_LIMIT_PER_MIN=10
LOGIN_MAX_FAILURES=5

# Receipts/attachments (local disk until S3 is configured).
UPLOAD_DIR=./uploads

# One line per request (time, method, path, status, duration, IP, user id, request id) — never bodies, headers or query strings.
# LOG_FORMAT=json writes one JSON object per line, for log tools. Every response carries an X-Request-Id header to match it.
LOG_REQUESTS=true
LOG_FORMAT=text
